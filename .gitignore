*.log
*.lock
*.tmp
*.tar
*.tar.gz
*.zip
*.whl
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Local Docker state
.docker/
*.image-id
config/local.env
config/*.local.yaml
config/*.local.json
config/*.local.yml
