{
  "backend": "harbor",
  "harbor": "/absolute/path/to/harbor",
  "agent": "qwen-coder",
  "model": "REPLACE_WITH_CONFIGURED_MODEL",
  "base_image": "naturebench-base:v3",
  "timeout_sec": 7200,
