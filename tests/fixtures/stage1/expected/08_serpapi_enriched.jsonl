{"schema_version": "paper-entry-merged-v1", "canonical_id": "paper-doi-5c4528d479385cbb2f9e", "identifiers": {"doi": "10.1039/d6ra07868k", "arxiv": null, "openalex": null, "pmid": null, "pmcid": null}, "title": "2-Aminooxazoles and 2-aminothiazoles: green regioselective synthesis and bioactivity.", "abstract": "2-Aminooxazole and 2-aminothiazole are heterocyclic compounds that can be developed to be therapeutically significant in medicinal chemistry as they are associated with a myriad of biologically important multicentric activities such as anticancer, anti-viral, anti-bacterial, anti-fungal, and enzyme inhibition. Chemically, they have been reported to target critical enzymes such as CDKs, aurora kinases, DHPS, and proteases. However, traditional routes to construct heterocyclic compounds are fraught with difficulties, such as poor regioselective control, producing C-4/C-5 regioisomeric mixtures,", "year": 2026, "document": {"local_path": null, "local_paths": [], "paper_url": "https://doi.org/10.1039/d6ra07868k", "paper_urls": ["https://doi.org/10.1039/d6ra07868k"], "pdf_url": null, "pdf_urls": []}, "resources": {"supplementary_urls": [], "code_urls": [], "data_urls": []}, "selection_context": {"domains": ["化学"], "difficulties": [], "tasks": [{"task_id": "51", "task_name": "有机反应产物预测（原名：Organic Reaction Product Prediction）"}]}, "merge": {"source_record_count": 1, "merge_reasons": [], "conflicts": {}}, "sources": [{"type": "manual", "record_id": "manual-13eb4e2056340f3ae82a", "file": "/fixture/pipeline/csv/NatureBench_非综述候选全量.csv", "sheet": null, "row": 1148, "record_path": "/fixture/pipeline/csv/NatureBench_非综述候选全量.csv:row=1148", "selection_context": {"domain": "化学", "difficulty": null, "task_id": "51", "task_name": "有机反应产物预测（原名：Organic Reaction Product Prediction）", "source_rank": null, "source_score": null}}], "resource_provenance": [], "resource_status": {"supplementary": {"status": "not_found", "reason": "serpapi_search_completed_without_target_type_candidate"